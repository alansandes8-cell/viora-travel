# ═══════════════════════ VIORA TRAVEL — variables de entorno ═══════════════════════
# Copiá este archivo como .env y completalo. Nunca subas el .env al repositorio.
# Todas las claves son de servidor: ninguna se envía al navegador (salvo las NEXT_PUBLIC_*).

# ── Obligatorias ──
# Dominio público (Caddy obtiene el certificado HTTPS automáticamente).
DOMAIN=viora.ejemplo.com
# Dominio anterior (opcional): sus enlaces redirigen al dominio actual. Ej.: OLD_DOMAIN=vioratravel.duckdns.org
# OLD_DOMAIN=
APP_URL=https://viora.ejemplo.com
# Contraseña de la base de datos (usuario principal de la aplicación).
DB_PASSWORD=cambiar-por-una-clave-larga
# Contraseña del rol restringido que usan las páginas públicas (no puede leer datos internos).
PUBLIC_DB_PASSWORD=cambiar-por-otra-clave-larga
# Secreto para firmar URLs temporales (mínimo 32 caracteres). Generar con: openssl rand -base64 48
SESSION_SECRET=

# En desarrollo local (sin Docker) se usan estas dos en lugar de DB_PASSWORD:
# DATABASE_URL=postgres://viora:clave@localhost:5432/viora
# DATABASE_URL_PUBLIC=postgres://viora_public:clave@localhost:5432/viora

# ── Datos de la agencia ──
AGENCY_WHATSAPP=5491163716817
AGENCY_EMAIL=alansandesmkt@gmail.com
# Número de legajo / razón social para el pie de página (Ley 18.829).
AGENCY_LEGAL_ID=

# ── Opcionales (si faltan, el panel muestra "no configurado" y se usa la alternativa) ──
# IA gratuita para Viorita-bot y para entender el texto libre del cuestionario.
# Google Gemini: clave gratis en https://aistudio.google.com/apikey (plan gratuito con límite diario).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Alternativa gratuita: Groq (https://console.groq.com/keys).
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# IA (Claude, pago). Sin clave: motor determinista completo, sin textos personalizados ni investigación asistida.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Email de avisos por SMTP. Gratis con Gmail + "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Imágenes. Las fotos de lugares emblemáticos salen de Wikipedia sin clave (se precargan al iniciar;
# MEDIA_WARMUP=0 lo desactiva). Unsplash y Pexels (gratuitas con registro) quedan como alternativa.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# WIKIMEDIA_DISABLED=1

# Videos (YouTube Data API v3, cuota gratuita diaria).
YOUTUBE_API_KEY=

# Mapa: estilo de teselas MapLibre. Vacío = OpenFreeMap (gratuito). "none" = solo mapa esquemático.
NEXT_PUBLIC_MAP_STYLE_URL=

# PDF: ruta a Chromium (la imagen Docker ya lo incluye).
# CHROMIUM_PATH=/usr/bin/chromium
