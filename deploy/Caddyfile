# Dominio principal (DOMAIN en .env). Caddy obtiene y renueva solo los certificados HTTPS.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3000
}

# www.dominio → dominio (los dos funcionan; queda una sola dirección oficial).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Dominio anterior (OLD_DOMAIN en .env, p. ej. el de DuckDNS): los enlaces ya enviados siguen
# funcionando y llevan a la dirección nueva. Sin OLD_DOMAIN, este bloque no responde a nada real.
{$OLD_DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
